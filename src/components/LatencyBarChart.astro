---
const bars = [
  { label: '01', height: 45, latency: '38ms' },
  { label: '07', height: 28, latency: '29ms' },
  { label: '14', height: 82, latency: '64ms' },
  { label: '21', height: 95, latency: '78ms' },
  { label: '28', height: 60, latency: '46ms' },
  { label: '04', height: 75, latency: '52ms' },
];
---

<div class="bg-[#141620] border border-[#202434] rounded-2xl p-5 shadow-card flex flex-col justify-between">
  <!-- Header -->
  <div>
    <div class="flex items-center justify-between mb-1">
      <h3 class="text-sm font-bold text-white tracking-tight">API Throughput</h3>
      <span class="text-xs font-semibold text-emerald-400 flex items-center gap-0.5">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        +20%
      </span>
    </div>
    
    <div class="flex items-baseline gap-2">
      <span class="text-2xl font-extrabold text-white tracking-tight">46<span class="text-sm font-normal text-gray-400">ms</span></span>
      <span class="text-[11px] text-gray-400">Avg Global Latency</span>
    </div>
  </div>

  <!-- Vertical Bar Graph with Orange Gradient -->
  <div class="pt-4 pb-1">
    <div class="flex items-end justify-between gap-2.5 h-28 px-1">
      {bars.map((bar) => (
        <div class="flex-1 flex flex-col items-center gap-2 group relative">
          <!-- Tooltip on hover -->
          <div class="absolute -top-7 opacity-0 group-hover:opacity-100 transition-opacity bg-[#1c1f2d] text-[10px] text-brand-400 px-1.5 py-0.5 rounded border border-brand-500/30 shadow-sm pointer-events-none whitespace-nowrap z-10 font-mono">
            {bar.latency}
          </div>

          <!-- Bar column -->
          <div class="w-full max-w-[22px] bg-[#1a1c27] rounded-full h-full flex items-end p-[1.5px] overflow-hidden border border-[#24293a]">
            <div
              class="w-full rounded-full bg-gradient-to-t from-brand-600 via-brand-500 to-amber-400 group-hover:from-brand-500 group-hover:to-amber-300 transition-all duration-300 shadow-orange-glow"
              style={`height: ${bar.height}%`}
            ></div>
          </div>

          <!-- X Label -->
          <span class="text-[10px] text-gray-400 font-mono group-hover:text-brand-400 transition-colors">
            {bar.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>
