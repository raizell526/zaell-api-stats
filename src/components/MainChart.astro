---
import CardGridPattern from './CardGridPattern.astro';
import { mainTrafficChart } from '../data/mock';
---

<div class="bg-white/[0.02] border border-white/[0.06] rounded-2xl p-4 sm:p-7 shadow-xl flex flex-col justify-between overflow-hidden relative backdrop-blur-md w-full min-w-0 max-w-full">
  <!-- Grid Pattern Background Effect -->
  <CardGridPattern patternId="main-chart-pattern" className="opacity-30" />
  
  <!-- Header: Live Status + Dynamic Metrics & Toggle Controls -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2 relative z-10">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FF6B2C]/10 border border-[#FF6B2C]/20 text-[11px] font-mono font-bold text-[#FF6B2C]">
          <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#FF6B2C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          API Request Volume
        </span>
        <span class="text-[10px] sm:text-xs text-gray-400 font-mono">Global Throughput</span>
      </div>

      <!-- Big Metric & Status (Fully Responsive) -->
      <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap">
        <span id="chart-total-metric" class="text-xl sm:text-2xl lg:text-3xl font-extrabold font-mono text-white tracking-tight">
          {mainTrafficChart.thisWeek.currentTotal}
        </span>
        <span class="text-[10px] sm:text-xs text-emerald-400 font-mono font-semibold inline-flex items-center gap-1.5 shrink-0 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 mb-0.5 sm:mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span id="chart-trend-text">{mainTrafficChart.thisWeek.trendText}</span>
        </span>
      </div>
      <h2 class="text-[11px] sm:text-xs text-gray-400 mt-0.5 font-mono font-normal">Aggregated HTTP/2 & HTTP/3 Ingest Volume</h2>
    </div>

    <!-- Toggle Controls (High Contrast Accessible Switcher) -->
    <div class="flex items-center self-start sm:self-auto shrink-0">
      <div class="inline-flex rounded-lg sm:rounded-xl bg-black/60 backdrop-blur-md p-1 border border-white/[0.12] font-mono text-xs shadow-inner">
        <button
          id="btn-this-week"
          type="button"
          aria-label="Filter traffic volume by this week"
          class="flex items-center gap-1.5 px-3 py-1.5 text-[11px] sm:text-xs font-bold rounded-md sm:rounded-lg bg-[#C2410C] text-white transition-all shadow-md shadow-[#C2410C]/30"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
          <span>This Week</span>
        </button>
        <button
          id="btn-last-week"
          type="button"
          aria-label="Filter traffic volume by last week"
          class="flex items-center gap-1.5 px-3 py-1.5 text-[11px] sm:text-xs font-semibold text-gray-200 hover:text-white rounded-md sm:rounded-lg transition-all"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
          <span>Last Week</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Chart Container with Snug Bottom Sizing -->
  <div class="relative w-full h-[220px] sm:h-[265px] mt-1 -mb-1">
    <div id="peak-badge" class="absolute top-1 right-2 sm:right-6 z-10 flex items-center gap-1.5 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-lg bg-[#1f1d19]/90 border border-[#FF6B2C] text-[11px] sm:text-xs font-mono font-bold text-[#FF6B2C] shadow-md pointer-events-none backdrop-blur-md">
      <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
      <span>Peak: {mainTrafficChart.thisWeek.peakValue} ({mainTrafficChart.thisWeek.peakHour})</span>
    </div>
    <canvas id="traffic-line-chart" class="w-full h-full touch-pan-y pointer-events-auto" style="touch-action: pan-y;"></canvas>
  </div>
</div>

<script>
  import {
    Chart,
    LineController,
    LineElement,
    PointElement,
    LinearScale,
    CategoryScale,
    Filler,
    Tooltip,
  } from 'chart.js';
  import { mainTrafficChart } from '../data/mock';

  // Register only required chart modules (Tree-shaken)
  Chart.register(
    LineController,
    LineElement,
    PointElement,
    LinearScale,
    CategoryScale,
    Filler,
    Tooltip
  );

  let currentMode: 'thisWeek' | 'lastWeek' = 'thisWeek';
  let chartInstance: Chart | null = null;

  const canvas = document.getElementById('traffic-line-chart') as HTMLCanvasElement | null;
  const btnThisWeek = document.getElementById('btn-this-week');
  const btnLastWeek = document.getElementById('btn-last-week');
  const totalMetric = document.getElementById('chart-total-metric');
  const trendText = document.getElementById('chart-trend-text');
  const peakBadge = document.getElementById('peak-badge');

  function initChart() {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }

    const orangeGradient = ctx.createLinearGradient(0, 0, 0, 240);
    orangeGradient.addColorStop(0, 'rgba(255, 107, 44, 0.28)');
    orangeGradient.addColorStop(0.75, 'rgba(255, 107, 44, 0.03)');
    orangeGradient.addColorStop(1, 'rgba(255, 107, 44, 0)');

    const dataset = mainTrafficChart[currentMode];

    chartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: dataset.labels,
        datasets: [
          {
            label: 'This Week',
            data: [...dataset.currentPeriod],
            borderColor: '#FF6B2C',
            borderWidth: 2.5,
            backgroundColor: orangeGradient,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#FF6B2C',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 1.5,
            pointRadius: window.innerWidth < 640 ? 2.5 : 4,
            pointHoverRadius: 6,
          },
          {
            label: 'Previous Period',
            data: [...dataset.previousPeriod],
            borderColor: 'rgba(255, 255, 255, 0.18)',
            borderWidth: 1.5,
            borderDash: [4, 4],
            fill: false,
            tension: 0.4,
            pointRadius: 0,
            pointHoverRadius: 0,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: {
          duration: 650,
          easing: 'easeOutQuart',
        },
        events: ['mousemove', 'mouseout', 'click', 'touchstart'],
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: {
            display: false,
          },
          tooltip: {
            backgroundColor: 'rgba(14, 16, 23, 0.95)',
            titleColor: '#ffffff',
            bodyColor: '#9ca3af',
            borderColor: 'rgba(255, 255, 255, 0.12)',
            borderWidth: 1,
            padding: 8,
            cornerRadius: 8,
            displayColors: true,
            callbacks: {
              label: function (context: any) {
                const label = context.dataset.label || '';
                const val = context.parsed.y;
                return ` ${label}: ${val.toLocaleString()} req/s`;
              },
            },
          },
        },
        scales: {
          x: {
            grid: {
              color: 'rgba(255, 255, 255, 0.04)',
            },
            ticks: {
              color: '#9ca3af',
              font: {
                family: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
                size: window.innerWidth < 640 ? 9 : 10,
              },
              maxRotation: 0,
            },
          },
          y: {
            grid: {
              color: 'rgba(255, 255, 255, 0.04)',
            },
            ticks: {
              color: '#9ca3af',
              font: {
                family: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
                size: window.innerWidth < 640 ? 9 : 10,
              },
              callback: function (value: any) {
                const num = Number(value);
                return num >= 1000 ? `${(num / 1000).toFixed(0)}k` : `${num}`;
              },
            },
          },
        },
      },
    });
  }

  function setMode(mode: 'thisWeek' | 'lastWeek') {
    if (currentMode === mode && chartInstance) return;
    currentMode = mode;

    if (mode === 'thisWeek') {
      btnThisWeek?.classList.add('bg-[#C2410C]', 'text-white', 'shadow-md', 'shadow-[#C2410C]/30');
      btnThisWeek?.classList.remove('text-gray-200');
      btnLastWeek?.classList.remove('bg-[#C2410C]', 'text-white', 'shadow-md', 'shadow-[#C2410C]/30');
      btnLastWeek?.classList.add('text-gray-200');

      if (totalMetric) totalMetric.textContent = mainTrafficChart.thisWeek.currentTotal;
      if (trendText) trendText.textContent = mainTrafficChart.thisWeek.trendText;
      if (peakBadge) {
        peakBadge.style.display = 'flex';
        const span = peakBadge.querySelector('span');
        if (span) span.textContent = `Peak: ${mainTrafficChart.thisWeek.peakValue} (${mainTrafficChart.thisWeek.peakHour})`;
      }
    } else {
      btnLastWeek?.classList.add('bg-[#C2410C]', 'text-white', 'shadow-md', 'shadow-[#C2410C]/30');
      btnLastWeek?.classList.remove('text-gray-200');
      btnThisWeek?.classList.remove('bg-[#C2410C]', 'text-white', 'shadow-md', 'shadow-[#C2410C]/30');
      btnThisWeek?.classList.add('text-gray-200');

      if (totalMetric) totalMetric.textContent = mainTrafficChart.lastWeek.currentTotal;
      if (trendText) trendText.textContent = mainTrafficChart.lastWeek.trendText;
      if (peakBadge) {
        peakBadge.style.display = 'flex';
        const span = peakBadge.querySelector('span');
        if (span) span.textContent = `Peak: ${mainTrafficChart.lastWeek.peakValue} (${mainTrafficChart.lastWeek.peakHour})`;
      }
    }

    // Smooth Dataset Morphing
    if (chartInstance) {
      const dataset = mainTrafficChart[mode];
      chartInstance.data.labels = dataset.labels;
      chartInstance.data.datasets[0].data = [...dataset.currentPeriod];
      chartInstance.data.datasets[1].data = [...dataset.previousPeriod];
      chartInstance.update();
    } else {
      initChart();
    }
  }

  btnThisWeek?.addEventListener('click', () => setMode('thisWeek'));
  btnLastWeek?.addEventListener('click', () => setMode('lastWeek'));

  // Initialize immediately on DOM ready / load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChart);
  } else {
    initChart();
  }

  // Debounced Resize Listener
  let resizeTimer: NodeJS.Timeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (chartInstance) {
        chartInstance.resize();
      }
    }, 150);
  }, { passive: true });
</script>
