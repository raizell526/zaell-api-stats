---
import CardGridPattern from './CardGridPattern.astro';
import { initialEdgeNodes, initialRateLimitTiers, httpStatusDistribution } from '../data/mock';
---

<div class="flex flex-col gap-5 w-full min-w-0 max-w-full">
  <!-- Top Stat Strip -->
  <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/[0.06] rounded-xl sm:rounded-2xl bg-white/[0.02] border border-white/[0.06] backdrop-blur-md overflow-hidden w-full">
    <div class="p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-xs text-gray-400 font-mono">Global Edge Gateways</span>
      <div class="text-xl sm:text-2xl font-bold font-mono text-white mt-1">
        {initialEdgeNodes.length} <span class="text-xs text-emerald-400 font-normal">Operational</span>
      </div>
      <span class="text-[11px] sm:text-xs text-gray-500 font-mono mt-1">Multi-region anycast routing</span>
    </div>
    <div class="p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-xs text-gray-400 font-mono">Average Global Latency</span>
      <div class="text-xl sm:text-2xl font-bold font-mono text-white mt-1">
        17.5 ms <span class="text-xs text-gray-400 font-normal">Edge to Origin</span>
      </div>
      <span class="text-[11px] sm:text-xs text-emerald-400 font-mono mt-1">P95: 38ms Fast Tier</span>
    </div>
    <div class="p-4 sm:p-5 flex flex-col justify-between">
      <span class="text-xs text-gray-400 font-mono">API Cache Hit Ratio</span>
      <div class="text-xl sm:text-2xl font-bold font-mono text-white mt-1">
        92.4%
      </div>
      <span class="text-[11px] sm:text-xs text-emerald-400 font-mono mt-1">Edge response caching</span>
    </div>
  </div>

  <!-- Regional Edge Gateway Ingest Table -->
  <div class="bg-white/[0.02] border border-white/[0.06] rounded-xl sm:rounded-2xl p-4 sm:p-7 shadow-xl flex flex-col justify-between overflow-hidden relative backdrop-blur-md w-full min-w-0 max-w-full">
    <CardGridPattern patternId="edge-nodes-pattern" className="opacity-30" />
    
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4 relative z-10">
      <h2 class="flex items-center gap-2 text-xs sm:text-sm font-mono font-bold text-gray-200 uppercase">
        <svg class="w-4 h-4 text-[#FF6B2C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>Regional Edge Gateways</span>
      </h2>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] text-xs font-mono text-gray-300 border border-white/[0.08]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        All POPs Healthy
      </span>
    </div>

    <div class="overflow-x-auto relative z-10 w-full min-w-0 max-w-full">
      <table class="w-full min-w-[540px] text-left border-collapse text-xs font-mono">
        <thead>
          <tr class="text-xs text-gray-400 uppercase tracking-wider border-b border-white/[0.08] select-none font-medium">
            <th class="py-3.5 px-4 font-medium">GATEWAY NAME</th>
            <th class="py-3.5 px-4 font-medium">REGION CODE</th>
            <th class="py-3.5 px-4 font-medium">LOCATION</th>
            <th class="py-3.5 px-4 font-medium">TRAFFIC VOLUME</th>
            <th class="py-3.5 px-4 font-medium">LATENCY</th>
            <th class="py-3.5 px-4 font-medium text-right">STATUS</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.04] text-xs">
          {initialEdgeNodes.map((node) => (
            <tr class="hover:bg-white/[0.03] transition-colors">
              <td class="py-3.5 px-4 text-gray-200 font-medium whitespace-nowrap">{node.name}</td>
              <td class="py-3.5 px-4 text-[#FF6B2C] whitespace-nowrap">{node.regionCode}</td>
              <td class="py-3.5 px-4 text-gray-300 whitespace-nowrap">{node.location}</td>
              <td class="py-3.5 px-4 text-gray-400 whitespace-nowrap">{node.requestsTotal}</td>
              <td class="py-3.5 px-4 text-emerald-400 whitespace-nowrap">{node.latency}ms</td>
              <td class="py-3.5 px-4 text-right whitespace-nowrap">
                <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-[#15261a] text-emerald-400 border border-[#23452a]">
                  {node.uptime}% Uptime
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
