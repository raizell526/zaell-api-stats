---
interface Props {
  pageTitle?: string;
  category?: string;
}

const { pageTitle = 'API Stats Dashboard', category = 'Analytics / API Metrics' } = Astro.props;

const navTabs = [
  { 
    id: 'dashboard', 
    name: 'Dashboard', 
    icon: 'dashboard', 
    active: true, 
    title: 'API Stats Dashboard', 
    category: 'Analytics / Overview',
    subtitle: 'Overview & metrics'
  },
  { 
    id: 'live-logs', 
    name: 'Live Stream', 
    icon: 'terminal', 
    active: false, 
    title: 'Live API Request Stream', 
    category: 'Monitoring / Live Stream',
    subtitle: 'Real-time requests'
  },
  { 
    id: 'providers', 
    name: 'Endpoints SLA', 
    icon: 'server', 
    active: false, 
    title: 'Core API Endpoints SLA', 
    category: 'Services / Endpoints',
    subtitle: 'Health & latency'
  },
  { 
    id: 'storage', 
    name: 'Edge Gateways', 
    icon: 'database', 
    active: false, 
    title: 'Regional Edge Gateways & POPs', 
    category: 'Infrastructure / Edge',
    subtitle: 'Regional nodes'
  },
  { 
    id: 'docs', 
    name: 'API Docs', 
    icon: 'help', 
    active: false, 
    title: 'API Documentation & References', 
    category: 'Developers / Docs',
    subtitle: 'Interactive schema'
  },
];
---

<header id="dashboard-top" class="flex flex-col gap-4 select-none relative">
  <!-- Top Navigation & Brand Bar (Static Top) -->
  <div class="relative z-20 bg-[#0e1017]/95 backdrop-blur-2xl border-b border-white/[0.06] rounded-t-2xl sm:rounded-t-[34px] -mx-3.5 -mt-3.5 px-3.5 py-3 sm:-mx-7 sm:-mt-7 sm:px-7 sm:py-4 lg:-mx-8 lg:-mt-8 lg:px-8 lg:py-5 flex items-center justify-between gap-4 transition-all">
    
    <!-- Brand Logo Left -->
    <a href="#dashboard" class="nav-brand-link flex items-center gap-3 group py-0.5" data-tab-target="dashboard">
      <picture class="shrink-0">
        <source srcset="/favicon.png" type="image/webp" />
        <img 
          src="/favicon.png" 
          alt="Zaell Logo" 
          width="40" 
          height="40" 
          fetchpriority="high"
          decoding="async"
          class="w-9 h-9 sm:w-10 sm:h-10 object-contain rounded-xl shrink-0 group-hover:scale-105 transition-transform" 
        />
      </picture>
      <div>
        <div class="font-bold text-base sm:text-lg lg:text-xl tracking-tight text-white group-hover:text-[#FF6B2C] transition-colors flex items-center gap-1.5 font-mono">
          zaell <span class="text-[#FF6B2C]">API Stats</span>
        </div>
        <p class="text-[11px] sm:text-xs text-gray-400 font-mono">MONITORING & ANALYTICS</p>
      </div>
    </a>

    <!-- Center: Desktop Navigation Tabs (Hidden on mobile/tablet) -->
    <nav class="hidden lg:flex items-center gap-1 p-1 rounded-xl bg-white/[0.03] border border-white/[0.06]">
      {navTabs.map((tab) => (
        <button
          type="button"
          data-tab-target={tab.id}
          data-tab-title={tab.title}
          data-tab-category={tab.category}
          class={`nav-tab-btn flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all whitespace-nowrap cursor-pointer ${
            tab.active
              ? 'bg-[#FF6B2C] text-white shadow-sm'
              : 'text-gray-400 hover:text-white hover:bg-white/[0.05]'
          }`}
        >
          {tab.icon === 'dashboard' && (
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
            </svg>
          )}
          {tab.icon === 'terminal' && (
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          )}
          {tab.icon === 'server' && (
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
            </svg>
          )}
          {tab.icon === 'database' && (
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
            </svg>
          )}
          {tab.icon === 'help' && (
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          )}
          <span>{tab.name}</span>
        </button>
      ))}
    </nav>

    <!-- Right Controls: Status & Mobile Hamburger Button -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Status Badge -->
      <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#15261a] border border-[#23452a] text-xs font-mono font-medium text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>All Systems Normal</span>
      </div>

      <!-- Mobile Hamburger Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="lg:hidden flex flex-col justify-center items-center w-9 h-9 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-gray-200 hover:text-white transition-all cursor-pointer relative z-50 p-2"
      >
        <span id="burger-line-1" class="w-4 h-0.5 bg-current rounded-full transition-all duration-300 ease-out transform origin-center"></span>
        <span id="burger-line-2" class="w-4 h-0.5 bg-current rounded-full transition-all duration-300 ease-out my-1"></span>
        <span id="burger-line-3" class="w-4 h-0.5 bg-current rounded-full transition-all duration-300 ease-out transform origin-center"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Refined Dropdown Menu (Solid Opaque, Compact, Staggered Animation) -->
  <div
    id="mobile-menu-dropdown"
    class="lg:hidden absolute top-14 right-0 z-50 w-full max-w-[280px] sm:max-w-xs opacity-0 -translate-y-3 scale-95 pointer-events-none transition-all duration-300 ease-out transform"
  >
    <div class="bg-[#12141d] border border-white/[0.14] rounded-2xl p-2 shadow-2xl shadow-black flex flex-col gap-1 overflow-hidden">
      {navTabs.map((tab) => (
        <button
          type="button"
          data-tab-target={tab.id}
          data-tab-title={tab.title}
          data-tab-category={tab.category}
          class={`mobile-nav-btn mobile-stagger-item opacity-0 -translate-y-3.5 transition-all duration-300 ease-out flex items-center justify-between p-2.5 rounded-xl text-xs font-sans cursor-pointer w-full text-left border ${
            tab.active
              ? 'bg-white/[0.08] text-white border-[#FF6B2C]/40 shadow-sm'
              : 'text-gray-300 hover:text-white hover:bg-white/[0.04] border-transparent'
          }`}
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-colors ${
              tab.active 
                ? 'bg-[#FF6B2C] text-white shadow-md shadow-[#FF6B2C]/30' 
                : 'bg-white/[0.05] border border-white/[0.08] text-[#FF6B2C]'
            }`}>
              {tab.icon === 'dashboard' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                </svg>
              )}
              {tab.icon === 'terminal' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              )}
              {tab.icon === 'server' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                </svg>
              )}
              {tab.icon === 'database' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                </svg>
              )}
              {tab.icon === 'help' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              )}
            </div>
            <div class="flex flex-col min-w-0">
              <span class="font-medium text-xs text-white truncate">{tab.name}</span>
              <span class="text-[11px] text-gray-400 font-normal truncate">{tab.subtitle}</span>
            </div>
          </div>

          <div class="shrink-0 pl-2">
            {tab.active ? (
              <span class="w-2 h-2 rounded-full bg-[#FF6B2C] block shadow-sm shadow-[#FF6B2C]/50"></span>
            ) : (
              <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            )}
          </div>
        </button>
      ))}

      <!-- Mobile Status indicator in menu footer (Clean, Balanced Monospace Text) -->
      <div class="mobile-stagger-item opacity-0 -translate-y-3.5 transition-all duration-300 ease-out mt-1.5 pt-2 border-t border-white/[0.08] flex items-center justify-between px-2.5 py-1 text-[11px] font-mono select-none">
        <span class="flex items-center gap-1.5 text-emerald-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Cluster Healthy
        </span>
        <span class="text-gray-500 font-mono text-[10px]">v2.0 • API Platform</span>
      </div>
    </div>
  </div>

  <!-- Breadcrumb & Dynamic Section Title Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1 sm:pt-2">
    <div>
      <div id="header-category" class="text-xs font-mono text-gray-400">{category}</div>
      <h1 id="header-title" class="text-xl sm:text-2xl font-bold tracking-tight text-white mt-0.5 font-mono">{pageTitle}</h1>
    </div>
  </div>
</header>

<script>
  // Tab switching logic across desktop and mobile buttons
  const desktopTabBtns = document.querySelectorAll<HTMLButtonElement>('.nav-tab-btn');
  const mobileTabBtns = document.querySelectorAll<HTMLButtonElement>('.mobile-nav-btn');
  const tabViews = document.querySelectorAll<HTMLElement>('.tab-view');
  const titleEl = document.getElementById('header-title');
  const categoryEl = document.getElementById('header-category');
  const brandLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-brand-link');

  // Mobile menu toggle elements & staggered items
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuDropdown = document.getElementById('mobile-menu-dropdown');
  const mobileStaggerItems = document.querySelectorAll<HTMLElement>('.mobile-stagger-item');
  const burgerLine1 = document.getElementById('burger-line-1');
  const burgerLine2 = document.getElementById('burger-line-2');
  const burgerLine3 = document.getElementById('burger-line-3');

  let isMenuOpen = false;

  function toggleMobileMenu(open?: boolean) {
    isMenuOpen = typeof open === 'boolean' ? open : !isMenuOpen;
    mobileMenuBtn?.setAttribute('aria-expanded', isMenuOpen ? 'true' : 'false');

    if (isMenuOpen) {
      // Animate dropdown container in
      mobileMenuDropdown?.classList.remove('opacity-0', '-translate-y-3', 'scale-95', 'pointer-events-none');
      mobileMenuDropdown?.classList.add('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');

      // Stagger items cascading top-to-bottom with pleasant, noticeable pacing (60ms)
      mobileStaggerItems.forEach((item, index) => {
        setTimeout(() => {
          item.classList.remove('opacity-0', '-translate-y-3.5');
          item.classList.add('opacity-100', 'translate-y-0');
        }, index * 60);
      });

      // Animate hamburger to X
      burgerLine1?.classList.add('rotate-45', 'translate-y-1.5');
      burgerLine2?.classList.add('opacity-0', 'scale-0');
      burgerLine3?.classList.add('-rotate-45', '-translate-y-1.5');
    } else {
      // Reset staggered items immediately
      mobileStaggerItems.forEach((item) => {
        item.classList.remove('opacity-100', 'translate-y-0');
        item.classList.add('opacity-0', '-translate-y-3.5');
      });

      // Animate dropdown out
      mobileMenuDropdown?.classList.remove('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
      mobileMenuDropdown?.classList.add('opacity-0', '-translate-y-3', 'scale-95', 'pointer-events-none');

      // Animate X back to hamburger
      burgerLine1?.classList.remove('rotate-45', 'translate-y-1.5');
      burgerLine2?.classList.remove('opacity-0', 'scale-0');
      burgerLine3?.classList.remove('-rotate-45', '-translate-y-1.5');
    }
  }

  mobileMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMobileMenu();
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (isMenuOpen && !mobileMenuDropdown?.contains(e.target as Node) && !mobileMenuBtn?.contains(e.target as Node)) {
      toggleMobileMenu(false);
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMobileMenu(false);
    }
  });

  function switchTab(targetId: string, title?: string, category?: string) {
    // Update Desktop Tabs
    desktopTabBtns.forEach((btn) => {
      const isTarget = btn.getAttribute('data-tab-target') === targetId;
      if (isTarget) {
        btn.classList.add('bg-[#FF6B2C]', 'text-white', 'shadow-sm');
        btn.classList.remove('text-gray-400', 'hover:text-white', 'hover:bg-white/[0.05]');
      } else {
        btn.classList.remove('bg-[#FF6B2C]', 'text-white', 'shadow-sm');
        btn.classList.add('text-gray-400', 'hover:text-white', 'hover:bg-white/[0.05]');
      }
    });

    // Update Mobile Tabs
    mobileTabBtns.forEach((btn) => {
      const isTarget = btn.getAttribute('data-tab-target') === targetId;
      const iconBox = btn.querySelector('.rounded-lg');
      const rightIndicator = btn.querySelector('.shrink-0');

      if (isTarget) {
        btn.classList.add('bg-white/[0.08]', 'text-white', 'border-[#FF6B2C]/40', 'shadow-sm');
        btn.classList.remove('text-gray-300', 'hover:bg-white/[0.04]', 'border-transparent');
        if (iconBox) {
          iconBox.className = 'w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-colors bg-[#FF6B2C] text-white shadow-md shadow-[#FF6B2C]/30';
        }
        if (rightIndicator) {
          rightIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-[#FF6B2C] block shadow-sm shadow-[#FF6B2C]/50"></span>';
        }
      } else {
        btn.classList.remove('bg-white/[0.08]', 'text-white', 'border-[#FF6B2C]/40', 'shadow-sm');
        btn.classList.add('text-gray-300', 'hover:bg-white/[0.04]', 'border-transparent');
        if (iconBox) {
          iconBox.className = 'w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-colors bg-white/[0.05] border border-white/[0.08] text-[#FF6B2C]';
        }
        if (rightIndicator) {
          rightIndicator.innerHTML = '<svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>';
        }
      }
    });

    // Switch Tab Views
    tabViews.forEach((view) => {
      if (view.id === `view-${targetId}`) {
        view.classList.remove('hidden');
      } else {
        view.classList.add('hidden');
      }
    });

    if (titleEl && title) titleEl.textContent = title;
    if (categoryEl && category) categoryEl.textContent = category;

    // Auto-close mobile menu on selection
    if (isMenuOpen) {
      toggleMobileMenu(false);
    }
  }

  desktopTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-target') || 'dashboard';
      const title = btn.getAttribute('data-tab-title') || 'API Stats Dashboard';
      const category = btn.getAttribute('data-tab-category') || 'Analytics / Overview';
      switchTab(targetId, title, category);
    });
  });

  mobileTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-target') || 'dashboard';
      const title = btn.getAttribute('data-tab-title') || 'API Stats Dashboard';
      const category = btn.getAttribute('data-tab-category') || 'Analytics / Overview';
      switchTab(targetId, title, category);
    });
  });

  brandLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      switchTab('dashboard', 'API Stats Dashboard', 'Analytics / Overview');
    });
  });
</script>
