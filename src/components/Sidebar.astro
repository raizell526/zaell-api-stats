---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Dashboard', href: '/', icon: 'dashboard', active: true },
  { name: 'Live Logs', href: '#live-traffic', icon: 'terminal', active: false },
  { name: 'Providers', href: '#providers', icon: 'server', active: false },
  { name: 'Storage', href: '#storage', icon: 'database', active: false },
  { name: 'Docs & API', href: '#docs', icon: 'help', active: false },
];
---

<!-- Mobile Header Toggle Bar -->
<header class="md:hidden flex items-center justify-between p-3.5 bg-[#10121a]/85 backdrop-blur-xl border border-white/[0.08] sticky top-0 z-50 w-full mb-3 rounded-2xl">
  <div class="flex items-center gap-2.5">
    <div class="w-7 h-7 rounded-lg bg-[#FF6B2C] flex items-center justify-center text-white font-bold shadow-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <span class="font-bold text-base tracking-tight text-white">zaell<span class="text-[#FF6B2C]"> API</span></span>
  </div>
  <button id="mobile-menu-btn" class="p-2 rounded-lg bg-white/[0.06] border border-white/[0.1] text-gray-300 hover:text-white" aria-label="Toggle Navigation">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>

<!-- Mobile Slide-out Drawer Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden md:hidden"></div>

<!-- Floating Capsule Dock (Snug Fit, No Empty Space) -->
<aside
  id="sidebar"
  class="fixed inset-y-auto left-4 z-50 w-64 bg-[#10121a]/95 backdrop-blur-2xl border border-white/[0.12] rounded-3xl p-5 transition-transform duration-300 -translate-x-full md:translate-x-0 md:static md:w-16 md:h-fit md:self-center md:rounded-[36px] md:p-3 md:bg-[#0e1017]/85 md:shadow-2xl md:shrink-0 flex flex-col items-center gap-4 shadow-2xl"
>
  <!-- Brand Logo Icon -->
  <a href="/" class="flex items-center justify-center group" title="Zaell API">
    <div class="w-10 h-10 rounded-2xl bg-[#FF6B2C] flex items-center justify-center text-white shadow-lg shadow-[#FF6B2C]/30 transition-transform group-hover:scale-110">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <div class="md:hidden ml-3">
      <div class="font-bold text-base tracking-tight text-white flex items-center gap-1">
        zaell<span class="text-[#FF6B2C]"> API</span>
      </div>
      <p class="text-[10px] text-gray-400 font-mono">v1.0.5 • BYPASS CORE</p>
    </div>
  </a>

  <!-- Divider -->
  <div class="w-6 h-px bg-white/[0.1] hidden md:block"></div>

  <!-- Navigation Icon Pills with Floating Tooltips -->
  <nav class="flex flex-col items-center gap-2 w-full">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`relative flex items-center justify-center w-10 h-10 rounded-2xl transition-all group/item ${
          item.active
            ? 'bg-[#FF6B2C] text-white shadow-lg shadow-[#FF6B2C]/30'
            : 'text-gray-400 hover:text-white hover:bg-white/[0.08]'
        }`}
        title={item.name}
      >
        {item.icon === 'dashboard' && (
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
          </svg>
        )}
        {item.icon === 'terminal' && (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        )}
        {item.icon === 'server' && (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
        )}
        {item.icon === 'database' && (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
        )}
        {item.icon === 'help' && (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        )}

        <!-- Desktop Hover Tooltip Badge -->
        <span class="hidden md:block absolute left-14 px-2.5 py-1 rounded-xl bg-[#12141f] border border-white/10 text-[11px] font-medium text-white whitespace-nowrap opacity-0 pointer-events-none group-hover/item:opacity-100 transition-opacity shadow-2xl z-50 font-sans">
          {item.name}
        </span>
        <span class="md:hidden ml-3 text-xs font-medium">{item.name}</span>
      </a>
    ))}
  </nav>

  <!-- Divider -->
  <div class="w-6 h-px bg-white/[0.1] hidden md:block"></div>

  <!-- Bottom Node Status Indicator -->
  <div class="relative group/status flex items-center justify-center w-8 h-8 rounded-full bg-white/[0.04] border border-white/[0.08] text-emerald-400 cursor-pointer" title="Solver Node Online">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    
    <!-- Tooltip -->
    <span class="hidden md:block absolute left-14 px-2.5 py-1 rounded-xl bg-[#12141f] border border-white/10 text-[10px] font-mono text-emerald-400 whitespace-nowrap opacity-0 pointer-events-none group-hover/status:opacity-100 transition-opacity shadow-2xl z-50">
      • Solver ONLINE (5h 35m)
    </span>
  </div>
</aside>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function openSidebar() {
    sidebar?.classList.remove('-translate-x-full');
    overlay?.classList.remove('hidden');
  }

  function closeSidebar() {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
  }

  mobileBtn?.addEventListener('click', openSidebar);
  overlay?.addEventListener('click', closeSidebar);
</script>
