---
interface Props {
  className?: string;
  patternId?: string;
  squares?: number[][];
}

const {
  className = '',
  patternId = `grid-${Math.random().toString(36).substring(2, 9)}`,
  squares = [
    [7, 1], [8, 2], [9, 1], [10, 3], [7, 4], [8, 5]
  ]
} = Astro.props;

const width = 16;
const height = 16;
const x = "-8";
const y = "2";
---

<div class={`pointer-events-none absolute top-0 right-0 h-full w-full overflow-hidden [mask-image:radial-gradient(farthest-side_at_top_right,white,transparent)] opacity-60 ${className}`} aria-hidden="true">
  <div class="absolute inset-0 bg-gradient-to-l from-white/[0.03] to-transparent [mask-image:radial-gradient(farthest-side_at_top_right,white,transparent)]">
    <svg class="absolute inset-0 h-full w-full fill-white/[0.03] stroke-white/[0.07] mix-blend-overlay" aria-hidden="true">
      <defs>
        <pattern id={patternId} width={width} height={height} patternUnits="userSpaceOnUse" x={x} y={y}>
          <path d={`M.5 ${height}V.5H${width}`} fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" stroke-width="0" fill={`url(#${patternId})`} />
      {squares && (
        <svg x={x} y={y} class="overflow-visible">
          {squares.map(([sqX, sqY]) => (
            <rect
              stroke-width="0"
              width={width + 1}
              height={height + 1}
              x={sqX * width}
              y={sqY * height}
              class="fill-white/[0.09] stroke-white/[0.14]"
            />
          ))}
        </svg>
      )}
    </svg>
  </div>
</div>
